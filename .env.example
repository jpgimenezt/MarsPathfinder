# AresRoute - Martian Map & AI Voice Tactical Platform
# NASA Space Apps Challenge 2026

# Frontend Environment Variables (Vite - prefixed with VITE_)
# En producción HTTPS, el gateway de voz DEBE usar el protocolo seguro wss://
VITE_VOICE_GATEWAY_URL=wss://voice.aresroute.space/voice
VITE_AWS_AGENT_ENDPOINT=https://laf33lrf26heqguui3pe3zqjje0rrnaw.lambda-url.us-east-2.on.aws/

# Voice Gateway Server Environment Variables (voice-gateway/)
PORT=8088
AWS_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=amazon.nova-2-5-sonic
# Lista de orígenes autorizados para conectar al WebSocket (separados por coma)
ALLOWED_ORIGINS=https://ares-route.vercel.app,https://mars-pathfinder.vercel.app,https://jpgimenezt.github.io,http://localhost:5173,http://localhost:4173,http://localhost:3000

# AWS Agent Lambda Environment Variables (aws-agent/)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
